
const chart4 = {
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",

  "title": {
    "text": "Most Commonly Consumed Food Groups",
    "subtitle": "Percentage of people consuming each food group, 2011–12",
    "fontSize": 18,
    "subtitleFontSize": 12
  },

  "width": 550,
  "height": 360,

  "data": {
    "url": "Datasets V2/food_consumption_2011.csv",
    "format": {
      "type": "csv",
      "parse": {
        "state": "string",
        "food_group": "string",
        "percentage": "number"
      }
    }
  },

  "params": [
    {
      "name": "selectedState",
      "value": "VIC",
      "bind": {
        "input": "select",
        "name": "Select state: ",
        "options": [
          "VIC", "NSW", "QLD", "SA",
          "WA", "TAS", "ACT", "NT"
        ]
      }
    }
  ],

  "transform": [
    {
      "filter": "datum.state == selectedState"
    }
  ],

  "encoding": {
    "y": {
      "field": "food_group",
      "type": "nominal",
      "title": null,
      "sort": {
        "field": "percentage",
        "order": "descending"
      },
      "axis": {
        "labelLimit": 260,
        "labelFontSize": 11
      }
    },
    "x": {
      "field": "percentage",
      "type": "quantitative",
      "title": "People consuming (%)",
      "scale": {
        "domain": [0, 100]
      }
    },
    "tooltip": [
      {"field": "state", "title": "State"},
      {"field": "food_group", "title": "Food group"},
      {
        "field": "percentage",
        "title": "People (%)",
        "format": ".1f"
      }
    ]
  },

  "layer": [
    {
      "mark": {
        "type": "rule",
        "strokeWidth": 3,
        "color": "#b5d6bd"
      },
      "encoding": {
        "x2": {"datum": 0}
      }
    },
    {
      "mark": {
        "type": "circle",
        "size": 180,
        "color": "#216e48"
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 12,
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#24382d"
      },
      "encoding": {
        "text": {
          "field": "percentage",
          "type": "quantitative",
          "format": ".1f"
        }
      }
    }
  ],

  "config": {
    "font": "Arial",
    "view": {"stroke": null},
    "axis": {
      "grid": false,
      "domain": false
    }
  }
};

vegaEmbed("#chart4", chart4, {
  actions: false
}).catch(console.error);